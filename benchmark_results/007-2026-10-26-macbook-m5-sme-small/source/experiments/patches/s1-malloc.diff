+#include <cstddef>
 
 namespace ulmBLAS {
 
+//
+//  Buffers for the packed operands of the level 2 and level 3 routines: a
+//  routine takes its buffers with allocate(n) at the beginning of a call
+//  and returns them with release(block) at the end.
+//
+//  This used to be a pool that kept released blocks for later calls (lists
+//  of free blocks in hash tables behind a mutex).  Measured on an Apple M5
+//  (macOS 26) for the buffers of a DGEMM call, the pool cost more than
+//  allocating and freeing the blocks each time: the allocator of the C
+//  library keeps freed blocks itself, also large ones.  For a 16 x 16 x 16
+//  DGEMM the pool took about a third of the time.  allocate and release now
+//  call the allocator directly; they are thread safe because the
+//  allocator is, and a block may be released by any thread.
+//
 template <typename T>
 class MemoryPool
 {
     public:
 
         T *
-        allocate(size_t n);
+        allocate(std::size_t n);
 
         void
         release(T *block);
-
-        virtual
-        ~MemoryPool();
-
-    private:
-
-        typedef std::list<T *>                           BlockList;
-        typedef std::unordered_map<size_t, BlockList>    Free;
-        typedef std::unordered_map<T *, size_t>          Used;
-
-        Free        free_;
-        Used        used_;
-        BlockList   allocated_;
-        std::mutex  mutex_;
 };
 
 
