+//
+//  The cache of the calling thread (one per element type T, shared by all
+//  pools of T).
+//
+template <typename T>
+typename MemoryPool<T>::ThreadCache &
+MemoryPool<T>::threadCache()
+{
+    thread_local ThreadCache cache;
+    return cache;
+}
+
+template <typename T>
+MemoryPool<T>::ThreadCache::~ThreadCache()
+{
+    for (CacheEntry &e : entry) {
+        if (e.pool && !e.used) {
+            e.pool->releaseShared(e.block);
+        }
+    }
+}
+
 template <typename T>
 T *
 MemoryPool<T>::allocate(size_t n)
+{
+    ThreadCache &cache = threadCache();
+    CacheEntry  *empty = nullptr;
+
+    for (CacheEntry &e : cache.entry) {
+        if (e.pool==this && e.n==n && !e.used) {
+            e.used = true;
+            return e.block;
+        }
+        if (!e.pool && !empty) {
+            empty = &e;
+        }
+    }
+    T *block = allocateShared(n);
+    if (empty) {
+        *empty = CacheEntry{this, block, n, true};
+    }
+    return block;
+}
+
+template <typename T>
+void
+MemoryPool<T>::release(T *block)
+{
+    if (!block) {
+        return;
+    }
+    for (CacheEntry &e : threadCache().entry) {
+        if (e.pool==this && e.block==block) {
+            e.used = false;
+            return;
+        }
+    }
+    releaseShared(block);
+}
