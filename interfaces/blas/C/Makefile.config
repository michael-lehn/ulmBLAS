#
#  Builds the C interface (CBLAS) for configuration CONFIG, which is read from
#  $(CONFIG_PATH)config/make.$(CONFIG).inc.
#
#  OUTDIR     directory for the library and the generated header
#             (default: top-level directory)
#  BUILD_DIR  directory for object files (default: build.$(CONFIG))
#
TOPDIR       = ../../..
CONFIG_FILE  = $(CONFIG_PATH)config/make.$(CONFIG).inc

include $(TOPDIR)/make.inc
include $(CONFIG_FILE)

OUTDIR          ?= $(TOPDIR)
BUILD_DIR       ?= build.$(CONFIG)
SOURCE_FILES    := $(wildcard *.cc)
OBJECT_FILES    := $(patsubst %.cc, $(BUILD_DIR)/%.o, $(SOURCE_FILES))

CBLAS_LIB       := $(OUTDIR)/$(CBLAS_LIB_NAME)
CBLAS_HEADER    := $(OUTDIR)/$(CBLAS_HEADER_NAME)

CBLAS_DEFS      := -D'BLAS_HEADER=<$(CBLAS_HEADER_NAME)>' \
                   -D'CBLAS(x)=$(CBLAS_PREFIX) \#\# x' \
                   -D'ULMBLAS(x)=$(ULMBLAS_PREFIX) \#\# x' \
                   -D'CBLAS_H=$(CBLAS_INCLUDE_GUARD)'

ULMBLAS_CPPFLAGS += -I$(OUTDIR) -I$(TOPDIR) -DADD_ $(CBLAS_DEFS)

.DELETE_ON_ERROR :
.PHONY : all $(CONFIG) clean FORCE

all $(CONFIG) : $(CBLAS_LIB) $(CBLAS_HEADER)

$(CBLAS_LIB) : $(OBJECT_FILES)
	$(call make_archive,$@,$(OBJECT_FILES))

$(CBLAS_HEADER) : cblas.h.in $(CONFIG_FILE)
	@mkdir -p $(OUTDIR)
	$(call generate_header,cblas.h.in,$(CBLAS_DEFS),$@)

$(BUILD_DIR) :
	mkdir -p $@

$(BUILD_DIR)/compile.cmd : FORCE | $(BUILD_DIR)
	@$(call record_command,$(CXXCOMPILE),$@)

$(BUILD_DIR)/%.o : %.cc $(CBLAS_HEADER) $(BUILD_DIR)/compile.cmd
	$(CXXCOMPILE) -c -o $@ $<

ifneq ($(MAKECMDGOALS),clean)
-include $(OBJECT_FILES:.o=.d)
endif

clean :
	rm -rf $(BUILD_DIR)
	rm -f $(CBLAS_LIB) $(CBLAS_HEADER)
