#
#  Builds the C interface (CBLAS) for configuration CONFIG, which is read from
#  $(CONFIG_PATH)config/make.$(CONFIG).inc.
#
#  OUTDIR     directory for the library and the generated header
#             (default: top-level directory)
#  BUILD_DIR  directory for object files (default: build.$(CONFIG))
#
#  A configuration may set CBLAS_SUFFIX and ULMBLAS_SUFFIX (appended to the
#  names, e.g. _64 for cblas_dgemm_64, the ILP64 interface of ../shared)
#  and EXCLUDED_SOURCES (sources not built, e.g. the globals of the
#  reference CBLAS that the LP64 interface of the same library defines).
#
TOPDIR       = ../../..
CONFIG_FILE  = $(CONFIG_PATH)config/make.$(CONFIG).inc

include $(TOPDIR)/make.inc
include $(CONFIG_FILE)

OUTDIR          ?= $(TOPDIR)
BUILD_DIR       ?= build.$(CONFIG)
SOURCE_FILES    := $(filter-out $(EXCLUDED_SOURCES),$(wildcard *.cc))
OBJECT_FILES    := $(patsubst %.cc, $(BUILD_DIR)/%.o, $(SOURCE_FILES)) \
                   $(ULMBLAS_ASM_OBJECTS)

CBLAS_LIB       := $(OUTDIR)/$(CBLAS_LIB_NAME)
CBLAS_HEADER    := $(OUTDIR)/$(CBLAS_HEADER_NAME)
#  GEMM with arbitrary strides (gemm_strided.cc), not generated
STRIDED_HEADER  := $(OUTDIR)/ulmblas_strided.h

PASTE           := \#\#
CBLAS_DEFS      := -D'BLAS_HEADER=<$(CBLAS_HEADER_NAME)>' \
                   -D'CBLAS(x)=$(CBLAS_PREFIX) \#\# x$(if $(CBLAS_SUFFIX), $(PASTE) $(CBLAS_SUFFIX))' \
                   -D'ULMBLAS(x)=$(ULMBLAS_PREFIX) \#\# x$(if $(ULMBLAS_SUFFIX), $(PASTE) $(ULMBLAS_SUFFIX))' \
                   -D'CBLAS_H=$(CBLAS_INCLUDE_GUARD)' \
                   -D'CBLAS_XERBLA_CALLBACK_T=cblas_xerbla$(CBLAS_SUFFIX)_callback_t' \
                   -D'BLAS_FORTRAN_XERBLA_CALLBACK_T=blas_fortran_xerbla$(CBLAS_SUFFIX)_callback_t'

ULMBLAS_CPPFLAGS += -I$(OUTDIR) -I$(TOPDIR) -DADD_ $(CBLAS_DEFS)

.DELETE_ON_ERROR :
.PHONY : all $(CONFIG) clean FORCE

all $(CONFIG) : $(CBLAS_LIB) $(CBLAS_HEADER) $(STRIDED_HEADER)

$(CBLAS_LIB) : $(OBJECT_FILES)
	$(call make_archive,$@,$(OBJECT_FILES))

#  The header carries the index type (ULMBLAS_INDEX_TYPE, from the compile
#  command): it is regenerated when the command changes.
$(CBLAS_HEADER) : cblas.h.in $(CONFIG_FILE) $(BUILD_DIR)/compile.cmd
	@mkdir -p $(OUTDIR)
	$(call generate_header,cblas.h.in,$(CBLAS_DEFS) $(ULMBLAS_INDEX_DEFS),$@)

$(STRIDED_HEADER) : ulmblas_strided.h
	@mkdir -p $(OUTDIR)
	cp $< $@

$(BUILD_DIR) :
	mkdir -p $@

$(BUILD_DIR)/compile.cmd : FORCE | $(BUILD_DIR)
	@$(call record_command,$(CXXCOMPILE),$@)

$(BUILD_DIR)/%.o : %.cc $(CBLAS_HEADER) $(BUILD_DIR)/compile.cmd
	$(CXXCOMPILE) -c -o $@ $<

$(BUILD_DIR)/%.o : $(ULMBLAS_ASM_DIR)/%.S $(BUILD_DIR)/compile.cmd
	$(ASCOMPILE) -c -o $@ $<

ifneq ($(MAKECMDGOALS),clean)
-include $(OBJECT_FILES:.o=.d)
endif

clean :
	rm -rf $(BUILD_DIR)
	rm -f $(CBLAS_LIB) $(CBLAS_HEADER) $(STRIDED_HEADER)
