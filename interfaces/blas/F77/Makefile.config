#
#  Builds the Fortran 77 interface for configuration CONFIG, which is read
#  from $(CONFIG_PATH)config/make.$(CONFIG).inc.  Some functions of this
#  interface are Fortran sources, hence a Fortran compiler is required.
#
#  OUTDIR     directory for the library and the generated header
#             (default: top-level directory)
#  BUILD_DIR  directory for object files (default: build.$(CONFIG))
#
TOPDIR       = ../../..
CONFIG_FILE  = $(CONFIG_PATH)config/make.$(CONFIG).inc

include $(TOPDIR)/make.inc
include $(CONFIG_FILE)

OUTDIR          ?= $(TOPDIR)
BUILD_DIR       ?= build.$(CONFIG)
CXX_SOURCES     := $(wildcard *.cc)
F77_SOURCES     := $(wildcard *.f)
CXX_OBJECTS     := $(patsubst %.cc, $(BUILD_DIR)/%.o, $(CXX_SOURCES))
F77_OBJECTS     := $(patsubst %.f, $(BUILD_DIR)/%.o, $(F77_SOURCES))
OBJECT_FILES    := $(CXX_OBJECTS) $(F77_OBJECTS)

F77BLAS_LIB     := $(OUTDIR)/$(F77BLAS_LIB_NAME)
F77BLAS_HEADER  := $(OUTDIR)/$(F77BLAS_HEADER_NAME)

F77BLAS_DEFS    := -D'BLAS_HEADER=<$(F77BLAS_HEADER_NAME)>' \
                   -D'F77BLAS(x)= x \#\# $(F77BLAS_SUFFIX)' \
                   -D'F77BLAS_H=$(F77BLAS_INCLUDE_GUARD)'

ULMBLAS_CPPFLAGS += -I$(OUTDIR) -I$(TOPDIR) $(F77BLAS_DEFS)

.DELETE_ON_ERROR :
.PHONY : all $(CONFIG) clean FORCE

all $(CONFIG) : $(F77BLAS_LIB) $(F77BLAS_HEADER)

$(F77BLAS_LIB) : $(OBJECT_FILES)
	$(call make_archive,$@,$(OBJECT_FILES))

$(F77BLAS_HEADER) : f77blas.h.in $(CONFIG_FILE)
	@mkdir -p $(OUTDIR)
	$(call generate_header,f77blas.h.in,$(F77BLAS_DEFS),$@)

$(BUILD_DIR) :
	mkdir -p $@

$(BUILD_DIR)/compile-cxx.cmd : FORCE | $(BUILD_DIR)
	@$(call record_command,$(CXXCOMPILE),$@)

$(BUILD_DIR)/compile-f.cmd : FORCE | $(BUILD_DIR)
	@$(call record_command,$(FCOMPILE),$@)

$(BUILD_DIR)/%.o : %.cc $(F77BLAS_HEADER) $(BUILD_DIR)/compile-cxx.cmd
	$(CXXCOMPILE) -c -o $@ $<

$(BUILD_DIR)/%.o : %.f $(BUILD_DIR)/compile-f.cmd
	$(FCOMPILE) -c -o $@ $<

ifneq ($(MAKECMDGOALS),clean)
-include $(CXX_OBJECTS:.o=.d)
endif

clean :
	rm -rf $(BUILD_DIR)
	rm -f $(F77BLAS_LIB) $(F77BLAS_HEADER)
