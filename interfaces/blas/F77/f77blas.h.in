//
//  Error handler, called with the name of the routine (length len, not
//  terminated by a null character) and the number of the invalid argument.
//  A program can replace it (SUBROUTINE XERBLA( SRNAME, INFO )).
//

void
F77BLAS(xerbla)(const char *rout, const ULMBLAS_INDEX_TYPE *info, size_t len);

