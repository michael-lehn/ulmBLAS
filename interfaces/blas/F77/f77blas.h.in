#define VERBOSE(X) X
#ifdef __cplusplus
#undef __cplusplus
#endif

VERBOSE(#ifndef) F77BLAS_H
VERBOSE(#define) F77BLAS_H 1

//
//  ULMBLAS_INDEX_TYPE: the integer type of dimensions, increments, leading
//  dimensions and indices.  It is chosen when ulmBLAS is built (make
//  ULMBLAS_INDEX_TYPE=..., default int; see INSTALL.md), and programs must
//  use the type of the library they link.
//
VERBOSE(#include) <stddef.h>
VERBOSE(#include) <stdint.h>

VERBOSE(#define) ULMBLAS_INDEX_TYPE ULMBLAS_INDEX_TYPE_OF_BUILD

VERBOSE(#ifdef) __cplusplus
extern "C" {
VERBOSE(#endif)

//
//  Fortran 77 interface of ulmBLAS for calls from C: all subroutines.  The
//  Fortran functions (e.g. DDOT, DZNRM2, ICAMAX, SDSDOT) are wrappers of
//  the subroutines declared here with the suffix _sub, which return the
//  result in their last argument.  All arguments are passed by reference.
//

//
//  Level 1
//

void
F77BLAS(sasum_sub)(const ULMBLAS_INDEX_TYPE *n_,
                   const float              *x,
                   const ULMBLAS_INDEX_TYPE *incX_,
                   float                    *result_);

