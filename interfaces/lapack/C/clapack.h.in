#define VERBOSE(X) X
#ifdef __cplusplus
#undef __cplusplus
#endif

VERBOSE(#ifndef) CLAPACK_H
VERBOSE(#define) CLAPACK_H 1

VERBOSE(#include) BLAS_HEADER

VERBOSE(#ifdef) __cplusplus
extern "C" {
VERBOSE(#endif)

ULMBLAS_INDEX_TYPE
ULMLAPACK(sgetrf)(enum CBLAS_ORDER   order,
                  ULMBLAS_INDEX_TYPE m,
                  ULMBLAS_INDEX_TYPE n,
                  float              *A,
                  ULMBLAS_INDEX_TYPE ldA,
                  ULMBLAS_INDEX_TYPE *piv);

ULMBLAS_INDEX_TYPE
ULMLAPACK(dgetrf)(enum CBLAS_ORDER   order,
                  ULMBLAS_INDEX_TYPE m,
                  ULMBLAS_INDEX_TYPE n,
                  double             *A,
                  ULMBLAS_INDEX_TYPE ldA,
                  ULMBLAS_INDEX_TYPE *piv);

ULMBLAS_INDEX_TYPE
ULMLAPACK(cgetrf)(enum CBLAS_ORDER   order,
                  ULMBLAS_INDEX_TYPE m,
                  ULMBLAS_INDEX_TYPE n,
                  void               *A,
                  ULMBLAS_INDEX_TYPE ldA,
                  ULMBLAS_INDEX_TYPE *piv);

ULMBLAS_INDEX_TYPE
ULMLAPACK(zgetrf)(enum CBLAS_ORDER   order,
                  ULMBLAS_INDEX_TYPE m,
                  ULMBLAS_INDEX_TYPE n,
                  void               *A,
                  ULMBLAS_INDEX_TYPE ldA,
                  ULMBLAS_INDEX_TYPE *piv);

ULMBLAS_INDEX_TYPE
ULMLAPACK(spotrf)(enum CBLAS_ORDER   order,
                  enum CBLAS_UPLO    upLo,
                  ULMBLAS_INDEX_TYPE n,
                  float              *A,
                  ULMBLAS_INDEX_TYPE ldA);

ULMBLAS_INDEX_TYPE
ULMLAPACK(dpotrf)(enum CBLAS_ORDER   order,
                  enum CBLAS_UPLO    upLo,
                  ULMBLAS_INDEX_TYPE n,
                  double             *A,
                  ULMBLAS_INDEX_TYPE ldA);

ULMBLAS_INDEX_TYPE
ULMLAPACK(cpotrf)(enum CBLAS_ORDER   order,
                  enum CBLAS_UPLO    upLo,
                  ULMBLAS_INDEX_TYPE n,
                  void               *A,
                  ULMBLAS_INDEX_TYPE ldA);

ULMBLAS_INDEX_TYPE
ULMLAPACK(zpotrf)(enum CBLAS_ORDER   order,
                  enum CBLAS_UPLO    upLo,
                  ULMBLAS_INDEX_TYPE n,
                  void               *A,
                  ULMBLAS_INDEX_TYPE ldA);

void
ULMLAPACK(dlaswp)(ULMBLAS_INDEX_TYPE n,
                  double             *A,
                  ULMBLAS_INDEX_TYPE ldA,
                  ULMBLAS_INDEX_TYPE k1,
                  ULMBLAS_INDEX_TYPE k2,
                  ULMBLAS_INDEX_TYPE *piv,
                  ULMBLAS_INDEX_TYPE incPiv);

//
//  Threads of ?getrf and ?potrf: n > 0 sets the number, n <= 0 restores
//  the default (omp_get_max_threads()); global setting.  Without OpenMP
//  the functions are serial and get_num_threads returns 1.
//
void
ULMLAPACK(set_num_threads)(int n);

int
ULMLAPACK(get_num_threads)(void);

VERBOSE(#ifdef) __cplusplus
} // extern "C"
VERBOSE(#endif)

VERBOSE(#endif) // CLAPACK_H
