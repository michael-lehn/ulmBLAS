//
//  Threads of ?getrf and ?potrf: n > 0 sets the number, n <= 0 restores
//  the default (omp_get_max_threads()); global setting.  Without OpenMP
//  the functions are serial and get_num_threads returns 1.
//
void
ULMLAPACK(set_num_threads)(int n);

int
ULMLAPACK(get_num_threads)(void);

