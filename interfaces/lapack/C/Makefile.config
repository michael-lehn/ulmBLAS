#
#  Builds the C interface of the LAPACK functions for configuration CONFIG.
#  The configuration is shared with the C interface of BLAS and read from
#  $(CONFIG_PATH)config/make.$(CONFIG).inc (default: the configurations in
#  ../../blas/C/config).
#
#  OUTDIR     directory for the library and the generated headers
#             (default: top-level directory)
#  BUILD_DIR  directory for object files (default: build.$(CONFIG))
#
TOPDIR             = ../../..
CBLASMAKEFILE_PATH = ../../blas/C
CONFIG_PATH       ?= $(CBLASMAKEFILE_PATH)/
CONFIG_FILE        = $(CONFIG_PATH)config/make.$(CONFIG).inc

include $(TOPDIR)/make.inc
include $(CONFIG_FILE)

OUTDIR          ?= $(TOPDIR)
BUILD_DIR       ?= build.$(CONFIG)
SOURCE_FILES    := $(wildcard *.cc)
OBJECT_FILES    := $(patsubst %.cc, $(BUILD_DIR)/%.o, $(SOURCE_FILES)) \
                   $(ULMBLAS_ASM_OBJECTS)

CLAPACK_LIB     := $(OUTDIR)/$(CLAPACK_LIB_NAME)
CBLAS_HEADER    := $(OUTDIR)/$(CBLAS_HEADER_NAME)
CLAPACK_HEADER  := $(OUTDIR)/$(CLAPACK_HEADER_NAME)

CLAPACK_DEFS    := -D'BLAS_HEADER=<$(CBLAS_HEADER_NAME)>' \
                   -D'LAPACK_HEADER=<$(CLAPACK_HEADER_NAME)>' \
                   -D'CLAPACK(x)=$(CLAPACK_PREFIX) \#\# x' \
                   -D'ULMLAPACK(x)=$(ULMLAPACK_PREFIX) \#\# x' \
                   -D'CLAPACK_H=$(CLAPACK_INCLUDE_GUARD)'

ULMBLAS_CPPFLAGS += -I$(OUTDIR) -I$(TOPDIR) $(CLAPACK_DEFS)

.DELETE_ON_ERROR :
.PHONY : all $(CONFIG) clean FORCE

all $(CONFIG) : $(CLAPACK_LIB) $(CLAPACK_HEADER)

$(CLAPACK_LIB) : $(OBJECT_FILES)
	$(call make_archive,$@,$(OBJECT_FILES))

#
#  The generated BLAS header is included by the LAPACK header.  It is made
#  by the makefile of the C interface of BLAS.
#
$(CBLAS_HEADER) : FORCE
	$(MAKE) -C $(CBLASMAKEFILE_PATH) -f Makefile.config \
	        CONFIG=$(CONFIG) CONFIG_PATH=$(abspath $(CONFIG_PATH))/ \
	        OUTDIR=$(abspath $(OUTDIR)) $(abspath $(CBLAS_HEADER))

$(CLAPACK_HEADER) : clapack.h.in $(CBLAS_HEADER) $(CONFIG_FILE)
	$(call generate_header,clapack.h.in,$(CLAPACK_DEFS),$@)

$(BUILD_DIR) :
	mkdir -p $@

$(BUILD_DIR)/compile.cmd : FORCE | $(BUILD_DIR)
	@$(call record_command,$(CXXCOMPILE),$@)

$(BUILD_DIR)/%.o : %.cc $(CBLAS_HEADER) $(CLAPACK_HEADER) $(BUILD_DIR)/compile.cmd
	$(CXXCOMPILE) -c -o $@ $<

$(BUILD_DIR)/%.o : $(ULMBLAS_ASM_DIR)/%.S $(BUILD_DIR)/compile.cmd
	$(ASCOMPILE) -c -o $@ $<

ifneq ($(MAKECMDGOALS),clean)
-include $(OBJECT_FILES:.o=.d)
endif

clean :
	rm -rf $(BUILD_DIR)
	rm -f $(CLAPACK_LIB) $(CLAPACK_HEADER)
