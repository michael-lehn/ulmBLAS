//
//  Fortran 77 interface of the LAPACK functions of ulmBLAS for calls from
//  C: all arguments by reference, IPIV 1-based, complex matrices as pairs
//  of real numbers.  The length of a CHARACTER argument (UPLO) follows the
//  other arguments (size_t, as with gfortran 8 or newer and flang).
//

void
F77BLAS(sgetrf)(const ULMBLAS_INDEX_TYPE *m,
                const ULMBLAS_INDEX_TYPE *n,
                float                    *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *ipiv,
                ULMBLAS_INDEX_TYPE       *info);

void
F77BLAS(dgetrf)(const ULMBLAS_INDEX_TYPE *m,
                const ULMBLAS_INDEX_TYPE *n,
                double                   *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *ipiv,
                ULMBLAS_INDEX_TYPE       *info);

void
F77BLAS(cgetrf)(const ULMBLAS_INDEX_TYPE *m,
                const ULMBLAS_INDEX_TYPE *n,
                float                    *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *ipiv,
                ULMBLAS_INDEX_TYPE       *info);

void
F77BLAS(zgetrf)(const ULMBLAS_INDEX_TYPE *m,
                const ULMBLAS_INDEX_TYPE *n,
                double                   *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *ipiv,
                ULMBLAS_INDEX_TYPE       *info);

void
F77BLAS(spotrf)(const char               *upLo,
                const ULMBLAS_INDEX_TYPE *n,
                float                    *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *info,
                size_t                   upLo_len);

void
F77BLAS(dpotrf)(const char               *upLo,
                const ULMBLAS_INDEX_TYPE *n,
                double                   *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *info,
                size_t                   upLo_len);

void
F77BLAS(cpotrf)(const char               *upLo,
                const ULMBLAS_INDEX_TYPE *n,
                float                    *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *info,
                size_t                   upLo_len);

void
F77BLAS(zpotrf)(const char               *upLo,
                const ULMBLAS_INDEX_TYPE *n,
                double                   *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                ULMBLAS_INDEX_TYPE       *info,
                size_t                   upLo_len);

//
//  Solves and inverses (see interfaces/lapack/F77/solve.cc)
//
void
F77BLAS(sgetrs)(const char *trans,
                const ULMBLAS_INDEX_TYPE *n,
                const ULMBLAS_INDEX_TYPE *nrhs,
                const float *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                const ULMBLAS_INDEX_TYPE *ipiv,
                float *B,
                const ULMBLAS_INDEX_TYPE *ldB,
                ULMBLAS_INDEX_TYPE *info,
                size_t a_len);

void
F77BLAS(sgesv)(const ULMBLAS_INDEX_TYPE *n,
               const ULMBLAS_INDEX_TYPE *nrhs,
               float *A,
               const ULMBLAS_INDEX_TYPE *ldA,
               ULMBLAS_INDEX_TYPE *ipiv,
               float *B,
               const ULMBLAS_INDEX_TYPE *ldB,
               ULMBLAS_INDEX_TYPE *info);

void
F77BLAS(sgetri)(const ULMBLAS_INDEX_TYPE *n,
                float *A,
                const ULMBLAS_INDEX_TYPE *ldA,
                const ULMBLAS_INDEX_TYPE *ipiv,
                float *work,
                const ULMBLAS_INDEX_TYPE *lwork,
                ULMBLAS_INDEX_TYPE *info);

void
F77BLAS(spotrs)(const char *upLo,
