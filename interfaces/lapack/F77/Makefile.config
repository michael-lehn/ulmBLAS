#
#  Builds the Fortran 77 interface of the LAPACK functions (?getrf, ?potrf)
#  for configuration CONFIG.  The configuration is shared with the Fortran
#  77 interface of BLAS and read from $(CONFIG_PATH)config/make.$(CONFIG).inc
#  (default: the configurations in ../../blas/F77/config).  The functions
#  report invalid arguments with XERBLA of the BLAS interface, so the
#  library is linked together with lib$(CONFIG)blas.a.
#
#  OUTDIR     directory for the library and the generated header
#             (default: top-level directory)
#  BUILD_DIR  directory for object files (default: build.$(CONFIG))
#
TOPDIR             = ../../..
F77BLASMAKEFILE_PATH = ../../blas/F77
CONFIG_PATH       ?= $(F77BLASMAKEFILE_PATH)/
CONFIG_FILE        = $(CONFIG_PATH)config/make.$(CONFIG).inc

include $(TOPDIR)/make.inc
include $(CONFIG_FILE)

OUTDIR            ?= $(TOPDIR)
BUILD_DIR         ?= build.$(CONFIG)
SOURCE_FILES      := $(wildcard *.cc)
OBJECT_FILES      := $(patsubst %.cc, $(BUILD_DIR)/%.o, $(SOURCE_FILES))

F77LAPACK_LIB_NAME    = $(subst blas.a,lapack.a,$(F77BLAS_LIB_NAME))
F77LAPACK_HEADER_NAME = $(subst blas.h,lapack.h,$(F77BLAS_HEADER_NAME))
F77LAPACK_LIB     := $(OUTDIR)/$(F77LAPACK_LIB_NAME)
F77BLAS_HEADER    := $(OUTDIR)/$(F77BLAS_HEADER_NAME)
F77LAPACK_HEADER  := $(OUTDIR)/$(F77LAPACK_HEADER_NAME)

F77LAPACK_DEFS    := -D'BLAS_HEADER=<$(F77BLAS_HEADER_NAME)>' \
                     -D'LAPACK_HEADER=<$(F77LAPACK_HEADER_NAME)>' \
                     -D'F77BLAS(x)= x \#\# $(F77BLAS_SUFFIX)' \
                     -D'F77LAPACK_H=ULMBLAS_$(shell echo $(CONFIG) | tr "a-z" "A-Z")LAPACK_H'

ULMBLAS_CPPFLAGS  += -I$(OUTDIR) -I$(TOPDIR) $(F77LAPACK_DEFS)

.DELETE_ON_ERROR :
.PHONY : all $(CONFIG) clean FORCE

all $(CONFIG) : $(F77LAPACK_LIB) $(F77LAPACK_HEADER)

$(F77LAPACK_LIB) : $(OBJECT_FILES)
	$(call make_archive,$@,$(OBJECT_FILES))

#
#  The generated BLAS header is included by the LAPACK header.  It is made
#  by the makefile of the Fortran 77 interface of BLAS.
#
$(F77BLAS_HEADER) : FORCE
	$(MAKE) -C $(F77BLASMAKEFILE_PATH) -f Makefile.config \
	        CONFIG=$(CONFIG) CONFIG_PATH=$(abspath $(CONFIG_PATH))/ \
	        OUTDIR=$(abspath $(OUTDIR)) $(abspath $(F77BLAS_HEADER))

$(F77LAPACK_HEADER) : f77lapack.h.in $(F77BLAS_HEADER) $(CONFIG_FILE)
	@mkdir -p $(OUTDIR)
	$(call generate_header,f77lapack.h.in,$(F77LAPACK_DEFS),$@)

$(BUILD_DIR) :
	mkdir -p $@

$(BUILD_DIR)/compile.cmd : FORCE | $(BUILD_DIR)
	@$(call record_command,$(CXXCOMPILE),$@)

$(BUILD_DIR)/%.o : %.cc $(F77BLAS_HEADER) $(F77LAPACK_HEADER) $(BUILD_DIR)/compile.cmd
	$(CXXCOMPILE) -c -o $@ $<

ifneq ($(MAKECMDGOALS),clean)
-include $(OBJECT_FILES:.o=.d)
endif

clean :
	rm -rf $(BUILD_DIR)
	rm -f $(F77LAPACK_LIB) $(F77LAPACK_HEADER)
