#  uc3.env: environment of the ulmBLAS benchmark campaigns on bwUniCluster 3.0
#  (2026-10-26).  The job scripts in ../slurm contain these values as
#  defaults; the variables marked (env) can be overridden when submitting,
#  e.g.  CPU=5 ROUNDS=1 sbatch -p cpu_il bench.sbatch icelake
#
#  Workspace (ws_allocate ulmblas-bench 60; expires 2026-12-25)
W=/pfs/work9/workspace/scratch/ul_mlehn-ulmblas-bench          # (env)
#
#  Layout below $W:
#    src/                 blis-2.0.tar.gz, OpenBLAS-0.3.34.tar.gz,
#                         eigen-5.0.1.tar.gz, ulmBLAS (git clone), bench/ (= ../src)
#    ARCH/                ARCH = icelake (cpu_il) or zen4 (cpu)
#      ulmblas/           ulmBLAS build (libcblas.a)
#      refs/blis-auto/    BLIS 2.0, configure auto
#      refs/blis-haswell/ BLIS 2.0, configure haswell
#      refs/openblas/     OpenBLAS 0.3.34
#      eigen-5.0.1/       Eigen headers
#      bin/               bench-V, verify-V, info-V, peak
#      logs/              build logs, kernels.txt, compile-commands.txt
#      run-JOBID/         res/ (raw outputs) and logs/ of a campaign
#
#  Partitions per CPU type
PARTITION_icelake=cpu_il;  DEV_PARTITION_icelake=dev_cpu_il   # Xeon Platinum 8358
PARTITION_zen4=cpu;        DEV_PARTITION_zen4=dev_cpu         # EPYC 9454
#
#  Modules
MODULES="compiler/gnu/14.2"                 # build and run (libstdc++ of GCC 14)
MKL_LIB=/software/bwhpc/common/toolkit/Intel_OneAPI/mkl/2025.0/lib   # numlib/mkl/2025.0
AOCL_ROOT=/software/bwhpc/common/lib/aocl/5.0.0/aocc                 # lib/aocl/5.0.0
#
#  Revisions and versions
ULMBLAS_REV=21197f2                         # (env) library identical to febb852
BLIS=2.0          # sha256 08bbebd77914a6d1a43874ae5ec2f54fe6a77cba745f2532df28361b0f1ad1b3
OPENBLAS=0.3.34   # sha256 cd7e129868320cc2d033afa920e31202dfe0b8066a5b66661900ccc0f197dfed
EIGEN=5.0.1       # sha256 e9c326dc8c05cd1e044c71f30f1b2e34a6161a3b6ecf445d56b53ff1669e3dec
#
#  Builds
ULMBLAS_MAKE='make cblas CXX=g++ ARCHFLAGS="-mavx -mfma"'          # -O3 -fomit-frame-pointer
BLIS_CONFIGURE='./configure --disable-shared --enable-cblas -t no CONFIG'   # CONFIG = auto, haswell
OPENBLAS_MAKE='make USE_THREAD=0 USE_OPENMP=0 NO_SHARED=1 NOFORTRAN=1 NO_LAPACK=1'
CC_BENCH='gcc -O2 -no-pie'                  # bench2.c, verify-large.c, info programs
CXX_EIGEN='g++ -std=c++17 -O3 -DNDEBUG -march=native'
MKL_LINK='-Wl,--start-group libmkl_intel_lp64.a libmkl_sequential.a libmkl_core.a -Wl,--end-group -lpthread -lm -ldl'
#
#  Campaign (bench.sbatch)
VARIANTS="ulmblas blis-auto blis-haswell openblas mkl aocl eigen"   # (env)
CPU=3                                       # (env) core; bound with numactl to it and its NUMA node
ROUNDS=3                                    # (env) rounds of the shapes "main" and "beta0"
SWEEP_ROUNDS=5                              # (env) rounds of the sweep n = 2 ... 512
SAMPLES=7                                   # samples of at least 0.2 s per size (bench2.c)
