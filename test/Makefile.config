#
#  Builds the libraries and test programs of test configuration CONFIG
#  (config/make.$(CONFIG).inc) in build/$(CONFIG):
#
#      lib/          libcblas.a, libclapack.a, libf77blas.a and headers
#      obj-*/        object files of the libraries
#      numeric/      numeric_tests (C++ tests, numeric/*.cc)
#      netlib-C/     Netlib CBLAS test programs (C and Fortran, C/*)
#      netlib-F77/   Netlib BLAS test programs (Fortran, F77/*)
#
#  Targets: libs (C interfaces), libs-f77 (Fortran 77 interface), numeric,
#  netlib-C, netlib-F77, clean.  The libraries are only built by the targets
#  libs and libs-f77, which test/Makefile runs before the test programs are
#  built (so that test programs of a configuration can be built in parallel
#  without building the libraries concurrently).  The tests are run by
#  run-tests.sh (see Makefile).
#
TOPDIR       = ..
TESTDIR      = $(CURDIR)
CONFIG_FILE  = $(TESTDIR)/config/make.$(CONFIG).inc

include $(TOPDIR)/make.inc
include $(CONFIG_FILE)

B             = $(TESTDIR)/build/$(CONFIG)
LIBDIR        = $(B)/lib

CBLAS_LIB     = $(LIBDIR)/$(CBLAS_LIB_NAME)
CLAPACK_LIB   = $(LIBDIR)/$(CLAPACK_LIB_NAME)
F77BLAS_LIB   = $(LIBDIR)/$(F77BLAS_LIB_NAME)

LIBMAKE       = $(MAKE) -f Makefile.config CONFIG=$(CONFIG) \
                        CONFIG_PATH=$(TESTDIR)/ OUTDIR=$(LIBDIR)

#
#  Numeric tests (C++)
#
NUMERIC_SOURCES = $(wildcard numeric/*.cc)
NUMERIC_OBJECTS = $(patsubst numeric/%.cc, $(B)/numeric/%.o, \
                             $(NUMERIC_SOURCES))
NUMERIC_TESTS   = $(B)/numeric/numeric_tests

NUMERIC_DEFS    = -D'BLAS_HEADER=<$(CBLAS_HEADER_NAME)>' \
                  -D'LAPACK_HEADER=<$(CLAPACK_HEADER_NAME)>' \
                  -D'ULMLAPACK(x)=$(ULMLAPACK_PREFIX) \#\# x'

#
#  Netlib CBLAS test suite: Fortran drivers calling the C interface through
#  C wrappers.  The drivers are compiled with -fallow-argument-mismatch if
#  the Fortran compiler supports it (required by gfortran 10 or newer for
#  c_[sd]blat1.f).  The C wrappers pass pointers to complex structures to
#  the C interface, which expects float/double pointers, hence
#  -Wno-incompatible-pointer-types (an error by default in GCC 14 or newer).
#
NETLIB_FFLAGS  = $(eval NETLIB_FFLAGS := $(shell \
                     echo | $(FC) -fallow-argument-mismatch -x f77 -c - \
                          -o /dev/null >/dev/null 2>&1 \
                     && echo -fallow-argument-mismatch) -w)$(NETLIB_FFLAGS)
NETLIB_CFLAGS  = -w -Wno-incompatible-pointer-types -DADD_ \
                 -D'BLAS_HEADER=<$(CBLAS_HEADER_NAME)>' \
                 -I$(LIBDIR) -I$(TOPDIR)

CBLAS_PROGRAMS = $(foreach t,s d c z,$(foreach l,1 2 3,c_$(t)blat$(l)))
CBLAS_TESTS    = $(patsubst %, $(B)/netlib-C/%, $(CBLAS_PROGRAMS))
CBLAS_AUX      = $(patsubst %, $(B)/netlib-C/%.o, auxiliary c_xerbla)

F77_PROGRAMS   = $(foreach t,s d c z,$(foreach l,1 2 3,$(t)blat$(l)))
F77_TESTS      = $(patsubst %, $(B)/netlib-F77/%, $(F77_PROGRAMS))
F77_INPUTS     = $(patsubst F77/%.dat.in, $(B)/netlib-F77/%.dat, \
                            $(wildcard F77/*.dat.in))

.DELETE_ON_ERROR :
.PHONY : all libs libs-f77 numeric netlib-C netlib-F77 clean FORCE

all : numeric

libs : $(CBLAS_LIB) $(CLAPACK_LIB)

libs-f77 : $(F77BLAS_LIB)

numeric : $(NUMERIC_TESTS)

netlib-C : $(CBLAS_TESTS)

netlib-F77 : $(F77_TESTS) $(F77_INPUTS)

#
#  Libraries of the configuration (up to date checks are done by the
#  makefiles of the interfaces).  The LAPACK interface uses the header of
#  the C interface of BLAS, hence it is built afterwards.
#
ifneq ($(filter libs,$(MAKECMDGOALS)),)
$(CBLAS_LIB) : FORCE
	$(LIBMAKE) -C $(TOPDIR)/interfaces/blas/C BUILD_DIR=$(B)/obj-cblas

$(CLAPACK_LIB) : $(CBLAS_LIB) FORCE
	$(LIBMAKE) -C $(TOPDIR)/interfaces/lapack/C BUILD_DIR=$(B)/obj-clapack
endif

ifneq ($(filter libs-f77,$(MAKECMDGOALS)),)
$(F77BLAS_LIB) : FORCE
	$(LIBMAKE) -C $(TOPDIR)/interfaces/blas/F77 BUILD_DIR=$(B)/obj-f77blas
endif

#
#  Numeric tests
#
$(B)/numeric $(B)/netlib-C $(B)/netlib-F77 :
	mkdir -p $@

$(B)/numeric/compile.cmd : FORCE | $(B)/numeric
	@$(call record_command,$(CXXCOMPILE) $(NUMERIC_DEFS) ; $(LDFLAGS) $(LDLIBS),$@)

$(B)/numeric/%.o : numeric/%.cc $(CLAPACK_LIB) $(B)/numeric/compile.cmd
	$(CXXCOMPILE) $(NUMERIC_DEFS) -I$(LIBDIR) -I$(TOPDIR) -c -o $@ $<

$(NUMERIC_TESTS) : $(NUMERIC_OBJECTS) $(CLAPACK_LIB) $(CBLAS_LIB)
	$(CXX) $(ULMBLAS_CXXFLAGS) $(CXXFLAGS) $(LDFLAGS) -o $@ \
	       $(NUMERIC_OBJECTS) $(CLAPACK_LIB) $(CBLAS_LIB) $(LDLIBS)

-include $(NUMERIC_OBJECTS:.o=.d)

#
#  Netlib CBLAS test suite
#
$(B)/netlib-C/compile.cmd : FORCE | $(B)/netlib-C
	@$(call record_command,$(CC) $(CFLAGS) ; $(FCOMPILE) $(NETLIB_FFLAGS) ; $(CXX) $(LDFLAGS) $(LDLIBS) $(FLIBS),$@)

$(B)/netlib-C/%.o : C/%.c $(CBLAS_LIB) $(B)/netlib-C/compile.cmd
	$(CC) $(CPPFLAGS) $(CFLAGS) $(NETLIB_CFLAGS) -c -o $@ $<

$(B)/netlib-C/%.o : C/%.f $(B)/netlib-C/compile.cmd
	$(FCOMPILE) $(NETLIB_FFLAGS) -c -o $@ $<

#
#  c_xblatN: Fortran driver c_xblatN.f and C wrappers c_xblasN.c, for
#  levels 2 and 3 also c_xNchke.c and the auxiliary functions.  Fortran
#  objects are linked with the C++ compiler (C++ runtime of the library) and
#  FLIBS (Fortran runtime).
#
define cblas_test_rule
$(B)/netlib-C/c_$(1)blat$(2) : $(B)/netlib-C/c_$(1)blat$(2).o \
                               $(B)/netlib-C/c_$(1)blas$(2).o \
                               $(if $(filter 1,$(2)),,$(B)/netlib-C/c_$(1)$(2)chke.o $(CBLAS_AUX)) \
                               $(CBLAS_LIB)
	$$(CXX) $$(ULMBLAS_CXXFLAGS) $$(CXXFLAGS) $$(LDFLAGS) -o $$@ \
	        $$(filter %.o,$$^) $$(CBLAS_LIB) $$(LDLIBS) $$(FLIBS)
endef

$(foreach t,s d c z,$(foreach l,1 2 3,$(eval $(call cblas_test_rule,$(t),$(l)))))

#
#  Netlib BLAS test suite for the Fortran 77 interface
#
$(B)/netlib-F77/compile.cmd : FORCE | $(B)/netlib-F77
	@$(call record_command,$(FCOMPILE) $(NETLIB_FFLAGS) ; $(CXX) $(LDFLAGS) $(LDLIBS) $(FLIBS),$@)

$(B)/netlib-F77/%.o : F77/%.f $(B)/netlib-F77/compile.cmd
	$(FCOMPILE) $(NETLIB_FFLAGS) -c -o $@ $<

$(F77_TESTS) : $(B)/netlib-F77/% : $(B)/netlib-F77/%.o $(F77BLAS_LIB)
	$(CXX) $(ULMBLAS_CXXFLAGS) $(CXXFLAGS) $(LDFLAGS) -o $@ $< \
	       $(F77BLAS_LIB) $(LDLIBS) $(FLIBS)

$(B)/netlib-F77/%.dat : F77/%.dat.in | $(B)/netlib-F77
	cp $< $@

clean :
	rm -rf $(B)
