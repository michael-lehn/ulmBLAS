TOPDIR     = ..
BENCH_DIR  = $(BENCH_DIR_PREFIX).$(CONFIG)
include $(TOPDIR)/make.inc
include $(CONFIG_PATH)config/make.$(CONFIG).inc

SOURCE_FILES = l1blastst.c l2blastst.c l3blastst.c lutst.c
OBJECT_FILES = $(patsubst %.c, $(BENCH_DIR)/%.o,   $(SOURCE_FILES))
TARGETS      = $(patsubst %.c, $(BENCH_DIR)/xd%,   $(SOURCE_FILES))

ATLAS_BLAS_LIBS   ?= $(patsubst %, $(TOPDIR)/%, $(ATLAS_BLAS_LIB_NAMES))
ATLAS_LAPACK_LIBS ?= $(patsubst %, $(TOPDIR)/%, $(ATLAS_LAPACK_LIB_NAMES))
REF_BLAS_LIBS     ?= $(patsubst %, $(TOPDIR)/%, $(REF_BLAS_LIB_NAMES))
RUN_BENCH_CMD      = $(BENCH_DIR)/$(BENCH_CMD)

LIBS         = $(ATLAS_LAPACK_LIBS) $(ATLAS_BLAS_LIBS) $(REF_BLAS_LIBS)

all: $(OBJECT_FILES) $(TARGETS)

$(BENCH_DIR) :
	mkdir -p $(BENCH_DIR)

#
#  The libraries are not built here: each library of ulmBLAS is built by its
#  own makefile, invoked once by the top-level target 'bench' (several
#  benchmark variants are built in parallel and must not build the same
#  library concurrently).
#
$(filter %.a,$(LIBS)) :
	@echo "error: library $@ not found." >&2; \
	 echo "  Build the benchmarks with 'make bench' in the top-level directory" >&2; \
	 echo "  (for ATLAS or MKL set ATLAS_LIBDIR or MKLROOT)." >&2; \
	 exit 1

$(BENCH_DIR)/%.o : %.c | $(BENCH_DIR)
	$(CC) $(BENCH_CFLAGS) $(ULMBLAS_CFLAGS) $(CFLAGS) -o $@ $<

$(BENCH_DIR)/xd% : $(BENCH_DIR)/%.o libtstatlas.a $(filter %.a,$(LIBS))
	$(CXX) $(ULMBLAS_CXXFLAGS) $(CXXFLAGS) $(LDFLAGS) -o $@ $< libtstatlas.a \
	       $(LIBS) $(LDLIBS) $(FLIBS)

.PHONY : clean
clean:
	rm -fr $(BENCH_DIR)

